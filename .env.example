# Anthropic API key used server-side by /api/analyze
ANTHROPIC_API_KEY=sk-ant-...

# Optional cost/quality knobs (defaults shown). claude-sonnet-5 at medium
# effort is the economical default; set claude-opus-5 + high for max quality.
#ANALYSIS_MODEL=claude-sonnet-5
#ANALYSIS_EFFORT=medium
# Max wines researched per photo (hard-caps web searches too)
#ANALYSIS_MAX_WINES=15

# PIN for the /admin page (delete saved scans). Admin is disabled if unset.
#ADMIN_PIN=1234

# Google-verified email whose login sees the Admin footer link
# (defaults to the deployment owner's email baked into lib/auth.ts).
#ADMIN_EMAIL=you@example.com

# Recommended: secret for signing login session cookies (any long random
# string, e.g. `openssl rand -base64 32`). A stable fallback is derived from
# the API key when unset.
#AUTH_SECRET=

# Optional: Google sign-in. Create an OAuth client (web application) in the
# Google Cloud console and register <your-domain>/api/auth/google/callback
# as an authorized redirect URI. Username/password accounts work without it.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=

# Optional: Redis-backed wine cache (Vercel Storage -> Upstash for Redis sets
# the KV_* pair automatically; a direct Upstash database uses the UPSTASH_* pair).
# Leave unset to disable caching.
#KV_REST_API_URL=
#KV_REST_API_TOKEN=
#UPSTASH_REDIS_REST_URL=
#UPSTASH_REDIS_REST_TOKEN=

# Optional: public gallery of shared summary cards (Vercel Storage -> Blob
# sets this automatically). Requires Redis above as well.
#BLOB_READ_WRITE_TOKEN=
